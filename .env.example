# ==========================================
# Mini Jira Environment Variables Template
# ==========================================

# Database Connection (Neon Serverless PostgreSQL)
# Server timezone — local dev only. Vercel REJECTS the name `TZ` (reserved by
# Lambda), so app code never reads server-local time: bucket/format logic uses
# APP_TIMEZONE below and behaves identically on every environment.
TZ="Asia/Ho_Chi_Minh"
# IANA zone for timesheet/burndown day buckets (optional — defaults to Asia/Ho_Chi_Minh).
# APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Shadow database for `prisma migrate dev` / `migrate diff` (never used by the app).
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_jira_shadow?schema=public"# - Production (Pooled with PgBouncer):
# DATABASE_URL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# - Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_jira?schema=public"

# (Optional) Direct connection for migrations:
# DIRECT_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
# Generate a secure 32-character secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-secret-here"
# Canonical URL:
# - Local: http://localhost:3000
# - Production: https://mini-jira.yourdomain.com (or https://your-project.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
# (Optional) Comma-separated trusted origins for CORS/cookie validation
# BETTER_AUTH_TRUSTED_ORIGINS="https://mini-jira.yourdomain.com,https://your-project.vercel.app"

# Cloudflare R2 Object Storage (File Attachments)
# Leave blank to automatically fall back to local disk storage (`storage/uploads`) in development.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="mini-jira-attachments"

# Outbound email via Resend (verify / reset-password / workspace-invite mails).
# Absent = log-only mode: auth flows keep working, nothing is sent.
# RESEND_API_KEY="re_your_key_here"
# EMAIL_FROM="Mini Jira <noreply@yourdomain.com>"
# Bật gate verify-mail. Chỉ bật ở prod SAU KHI verify domain Resend xong
# (test mode chỉ gửi được cho email chủ tài khoản — bật sớm là khóa đăng ký mới).
# REQUIRE_EMAIL_VERIFICATION="1"
